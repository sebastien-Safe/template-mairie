---
import { readFileSync } from "fs";
import { join } from "path";

let horaires: Record<string, string> = {};

try {
  const raw = readFileSync(join(process.cwd(), "src/content/horaires.md"), "utf-8");
  const lines = raw.split("\n");
  for (const line of lines) {
    const match = line.match(/^(\w+):\s*"([^"]+)"/);
    if (match) horaires[match[1]] = match[2];
  }
} catch {}

const jours = [
  { key: "lundi",     label: "Lundi" },
  { key: "mardi",     label: "Mardi" },
  { key: "mercredi",  label: "Mercredi" },
  { key: "jeudi",     label: "Jeudi" },
  { key: "vendredi",  label: "Vendredi" },
  { key: "samedi",    label: "Samedi" },
  { key: "dimanche",  label: "Dimanche" },
];
---

<dl class="horaires">
  {jours.map(({ key, label }) => horaires[key] && (
    <div class="ligne">
      <dt>{label}</dt>
      <dd>{horaires[key]}</dd>
    </div>
  ))}
</dl>

<style>
  .horaires { display: flex; flex-direction: column; gap: 0.4rem; }
  .ligne {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.9rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--gris-f);
  }
  dt { font-weight: 600; color: var(--texte); }
  dd { color: var(--gris-t); text-align: right; }

  :global(html[data-style="moderne"]) .ligne {
    border-bottom-color: var(--surface-bordure);
    border-radius: var(--rayon-petit);
    padding: 0.5rem 0.75rem;
    transition: background 0.2s ease;
  }
  :global(html[data-style="moderne"]) .ligne:hover {
    background: var(--surface-hover);
  }
</style>