---
import { commune, identite } from "../lib/config";

const liens = [
  { href: "/",            label: "Accueil" },
  { href: "/mairie/",     label: "La mairie" },
  { href: "/demarches/",  label: "Démarches" },
  { href: "/vie-locale/", label: "Vie locale" },
];

const pathname = Astro.url.pathname;
---

<header role="banner">
  <div class="barre-top">
    {identite.logo && <img src={identite.logo} alt="" class="logo-commune" />}
    <span class="nom-commune">{commune.nom_commune}</span>
  </div>
  <nav aria-label="Navigation principale">
    <ul role="list">
      {liens.map(({ href, label }) => (
        <li>
          <a href={href} aria-current={pathname === href ? "page" : undefined}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  header { border-bottom: 3px solid var(--bleu); }
  .barre-top {
    background: var(--bleu);
    color: var(--blanc);
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1.5rem;
  }
  .nom-commune {
    font-size: 1.25rem;
    font-weight: 700;
  }
  .logo-commune {
    height: 32px;
    width: auto;
  }
  nav { background: var(--blanc); padding: 0 1.5rem; }
  nav ul { display: flex; gap: 0; list-style: none; flex-wrap: wrap; }
  nav a {
    display: block;
    padding: 0.875rem 1.25rem;
    text-decoration: none;
    color: var(--texte);
    font-weight: 500;
    border-bottom: 3px solid transparent;
  }
  nav a:hover { border-bottom-color: var(--bleu); color: var(--bleu); }
  nav a[aria-current="page"] {
    border-bottom-color: var(--rouge);
    color: var(--rouge);
    font-weight: 700;
  }
  @media (max-width: 600px) {
    nav ul { flex-direction: column; }
    nav a { padding: 0.75rem 0; }
  }

  /* Style 2 — élégant : bandeau blanc, nom en Playfair italique, soulignement qui se déploie depuis le centre */
  :global(html[data-style="style2"]) header {
    border-bottom: 1px solid var(--gris-f);
  }
  :global(html[data-style="style2"]) .barre-top {
    background: var(--blanc);
    color: var(--texte);
    padding: 1.25rem 1.5rem 1rem;
  }
  :global(html[data-style="style2"]) .nom-commune {
    font-family: var(--ff-disp);
    font-style: italic;
    font-weight: 600;
    font-size: 1.4rem;
  }
  :global(html[data-style="style2"]) nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--blanc);
    border-bottom: 1px solid var(--gris-f);
  }
  :global(html[data-style="style2"]) nav a {
    position: relative;
    border-bottom: none;
    text-transform: uppercase;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    transition: color 0.18s linear;
  }
  :global(html[data-style="style2"]) nav a::after {
    content: "";
    position: absolute;
    left: 50%;
    right: 50%;
    bottom: 0.6rem;
    height: 1px;
    background: var(--rouge);
    transition: left 0.22s linear, right 0.22s linear;
  }
  :global(html[data-style="style2"]) nav a:hover {
    color: var(--bleu);
  }
  :global(html[data-style="style2"]) nav a:hover::after,
  :global(html[data-style="style2"]) nav a[aria-current="page"]::after {
    left: 1.25rem;
    right: 1.25rem;
  }
  :global(html[data-style="style2"]) nav a[aria-current="page"] {
    color: var(--rouge);
    font-weight: 700;
  }

  /* Style 3 — affiche : nom en Bebas Neue, liens capitales avec aplat de couleur au survol (snap) */
  :global(html[data-style="style3"]) .nom-commune {
    font-family: var(--ff-disp);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 1.7rem;
  }
  :global(html[data-style="style3"]) nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--blanc);
  }
  :global(html[data-style="style3"]) nav a {
    border-bottom: none;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.03em;
    transition: background 0.12s linear, color 0.12s linear;
  }
  :global(html[data-style="style3"]) nav a:hover {
    background: var(--bleu);
    color: var(--blanc);
  }
  :global(html[data-style="style3"]) nav a[aria-current="page"] {
    background: var(--rouge);
    color: var(--blanc);
  }
</style>