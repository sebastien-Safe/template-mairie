---
import { commune, identite } from "../lib/config";

const liens = [
  { href: "/",            label: "Accueil" },
  { href: "/mairie/",     label: "La mairie" },
  { href: "/demarches/",  label: "Démarches" },
  { href: "/vie-locale/", label: "Vie locale" },
];

const pathname = Astro.url.pathname;
---

<header role="banner">
  <div class="barre-top">
    {identite.logo && <img src={identite.logo} alt="" class="logo-commune" />}
    <span class="nom-commune">{commune.nom_commune}</span>
  </div>
  <nav aria-label="Navigation principale">
    <ul role="list">
      {liens.map(({ href, label }) => (
        <li>
          <a href={href} aria-current={pathname === href ? "page" : undefined}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  header { border-bottom: 3px solid var(--bleu); }
  .barre-top {
    background: var(--bleu);
    color: var(--blanc);
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1.5rem;
  }
  .nom-commune {
    font-size: 1.25rem;
    font-weight: 700;
  }
  .logo-commune {
    height: 32px;
    width: auto;
  }
  nav { background: var(--blanc); padding: 0 1.5rem; }
  nav ul { display: flex; gap: 0; list-style: none; flex-wrap: wrap; }
  nav a {
    display: block;
    padding: 0.875rem 1.25rem;
    text-decoration: none;
    color: var(--texte);
    font-weight: 500;
    border-bottom: 3px solid transparent;
  }
  nav a:hover { border-bottom-color: var(--bleu); color: var(--bleu); }
  nav a[aria-current="page"] {
    border-bottom-color: var(--rouge);
    color: var(--rouge);
    font-weight: 700;
  }
  @media (max-width: 600px) {
    nav ul { flex-direction: column; }
    nav a { padding: 0.75rem 0; }
  }

  :global(html[data-style="moderne"]) header {
    border-bottom: none;
    box-shadow: var(--ombre-carte);
  }
  :global(html[data-style="moderne"]) .barre-top {
    background: var(--degrade-vif);
    background-size: 200% 200%;
    animation: degrade-mouvant 16s ease infinite;
  }
  :global(html[data-style="moderne"]) .nom-commune {
    text-shadow: 0 2px 12px rgb(0 0 0 / 20%);
  }
  :global(html[data-style="moderne"]) nav {
    background: var(--surface);
    backdrop-filter: var(--flou);
    -webkit-backdrop-filter: var(--flou);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  :global(html[data-style="moderne"]) nav a {
    position: relative;
    border-bottom-color: transparent;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  :global(html[data-style="moderne"]) nav a::after {
    content: "";
    position: absolute;
    left: 1.25rem;
    right: 1.25rem;
    bottom: 0;
    height: 3px;
    border-radius: 2px 2px 0 0;
    background: var(--degrade-vif);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  :global(html[data-style="moderne"]) nav a:hover {
    color: var(--accent-vif);
    transform: translateY(-1px);
  }
  :global(html[data-style="moderne"]) nav a:hover::after,
  :global(html[data-style="moderne"]) nav a[aria-current="page"]::after {
    transform: scaleX(1);
  }
  :global(html[data-style="moderne"]) nav a[aria-current="page"] {
    background: var(--degrade-texte);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
</style>