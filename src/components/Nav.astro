---
import { commune, identite } from "../lib/config";

const liens = [
  { href: "/",            label: "Accueil" },
  { href: "/mairie/",     label: "La mairie" },
  { href: "/demarches/",  label: "Démarches" },
  { href: "/vie-locale/", label: "Vie locale" },
];

const pathname = Astro.url.pathname;
---

<header role="banner">
  <div class="barre-top">
    {identite.logo && <img src={identite.logo} alt="" class="logo-commune" />}
    <span class="nom-commune">{commune.nom_commune}</span>
  </div>
  <nav aria-label="Navigation principale">
    <ul role="list">
      {liens.map(({ href, label }) => (
        <li>
          <a href={href} aria-current={pathname === href ? "page" : undefined}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  header { border-bottom: 3px solid var(--bleu); }
  .barre-top {
    background: var(--bleu);
    color: var(--blanc);
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1.5rem;
  }
  .nom-commune {
    font-size: 1.25rem;
    font-weight: 700;
  }
  .logo-commune {
    height: 32px;
    width: auto;
  }
  nav { background: var(--blanc); padding: 0 1.5rem; }
  nav ul { display: flex; gap: 0; list-style: none; flex-wrap: wrap; }
  nav a {
    display: block;
    padding: 0.875rem 1.25rem;
    text-decoration: none;
    color: var(--texte);
    font-weight: 500;
    border-bottom: 3px solid transparent;
  }
  nav a:hover { border-bottom-color: var(--bleu); color: var(--bleu); }
  nav a[aria-current="page"] {
    border-bottom-color: var(--rouge);
    color: var(--rouge);
    font-weight: 700;
  }
  @media (max-width: 600px) {
    nav ul { flex-direction: column; }
    nav a { padding: 0.75rem 0; }
  }

  :global(html[data-style="foret"]) header,
  :global(html[data-style="techno"]) header {
    border-bottom: none;
    box-shadow: var(--ombre-carte);
  }
  :global(html[data-style="foret"]) .barre-top,
  :global(html[data-style="techno"]) .barre-top {
    background: var(--degrade-vif);
  }
  :global(html[data-style="techno"]) .barre-top {
    background-size: 200% 200%;
    animation: degrade-mouvant 16s ease infinite;
  }
  :global(html[data-style="techno"]) .nom-commune {
    text-shadow: 0 2px 12px rgb(0 0 0 / 20%);
  }
  :global(html[data-style="foret"]) nav,
  :global(html[data-style="techno"]) nav {
    background: var(--surface);
    backdrop-filter: var(--flou);
    -webkit-backdrop-filter: var(--flou);
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--surface-bordure);
  }
  :global(html[data-style="foret"]) nav ul,
  :global(html[data-style="techno"]) nav ul {
    gap: 0.25rem;
    padding: 0.5rem 0;
  }
  :global(html[data-style="foret"]) nav a,
  :global(html[data-style="techno"]) nav a {
    border-bottom: none;
    border-radius: var(--rayon-petit);
  }
  /* Forêt : transitions linéaires simples au survol des éléments cliquables */
  :global(html[data-style="foret"]) nav a {
    transition: background 0.18s linear, color 0.18s linear;
  }
  :global(html[data-style="foret"]) nav a:hover {
    background: var(--surface-hover);
    color: var(--bleu);
  }
  :global(html[data-style="foret"]) nav a[aria-current="page"] {
    background: var(--accent-vif);
    color: var(--blanc);
    font-weight: 700;
  }
  /* Techno : transparence + halo néon au survol */
  :global(html[data-style="techno"]) nav a {
    transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  }
  :global(html[data-style="techno"]) nav a:hover {
    background: var(--surface-hover);
    color: var(--blanc);
    box-shadow: 0 0 16px rgb(59 130 246 / 35%);
  }
  :global(html[data-style="techno"]) nav a[aria-current="page"] {
    background: var(--degrade-vif);
    color: var(--blanc);
    box-shadow: var(--ombre-glow);
    font-weight: 700;
  }
</style>