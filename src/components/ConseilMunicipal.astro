---
import { readFileSync, readdirSync } from "fs";
import { join } from "path";

interface Membre {
  nom: string;
  fonction: string;
  photo: string;
  ordre: number;
}

const membres: Membre[] = [];

try {
  const dir = join(process.cwd(), "src/content/conseil");
  const fichiers = readdirSync(dir).filter(f => f.endsWith(".md"));

  for (const fichier of fichiers) {
    const raw = readFileSync(join(dir, fichier), "utf-8");
    const nom      = raw.match(/nom:\s*"([^"]+)"/)?.[1] ?? "";
    const fonction = raw.match(/fonction:\s*"([^"]+)"/)?.[1] ?? "";
    const photo    = raw.match(/photo:\s*"([^"]*)"/)?.[1] ?? "";
    const ordre    = Number(raw.match(/ordre:\s*(-?\d+)/)?.[1] ?? 0);
    if (nom) membres.push({ nom, fonction, photo, ordre });
  }

  membres.sort((a, b) => a.ordre - b.ordre);
} catch {}
---

{membres.length === 0 ? (
  <p class="vide">Composition du conseil municipal à venir.</p>
) : (
  <ul class="conseil" role="list">
    {membres.map(m => (
      <li class="membre-carte">
        {m.photo ? (
          <img src={m.photo} alt="" class="photo" />
        ) : (
          <span class="photo photo-vide" aria-hidden="true"></span>
        )}
        <strong>{m.nom}</strong>
        <p>{m.fonction}</p>
      </li>
    ))}
  </ul>
)}

<style>
  .conseil {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1.5rem;
  }
  .membre-carte {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.4rem;
  }
  .photo {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--bleu);
  }
  .photo-vide {
    background: var(--surface);
  }
  strong { color: var(--bleu); font-weight: 600; }
  p { font-size: 0.85rem; color: var(--gris-t); margin: 0; }
  .vide { color: var(--gris-t); font-style: italic; }

  /* Style 2 — anneau rouge fin, léger soulèvement linéaire au survol */
  :global(html[data-style="style2"]) .photo {
    border: 2px solid var(--rouge);
  }
  :global(html[data-style="style2"]) .membre-carte {
    transition: transform 0.18s linear;
  }
  :global(html[data-style="style2"]) .membre-carte:hover {
    transform: translateY(-3px);
  }

  /* Style 3 — portrait "badge" légèrement incliné avec ombre portée dure */
  :global(html[data-style="style3"]) .photo {
    border-radius: 6px;
    border: 3px solid var(--bleu);
    box-shadow: 5px 5px 0 var(--rouge);
    transform: rotate(-2deg);
    transition: transform 0.15s linear, box-shadow 0.15s linear;
  }
  :global(html[data-style="style3"]) .membre-carte:nth-child(even) .photo {
    transform: rotate(2deg);
  }
  :global(html[data-style="style3"]) .membre-carte:hover .photo {
    transform: translate(-2px, -2px) rotate(0deg);
    box-shadow: 8px 8px 0 var(--rouge);
  }
</style>
