---
import { commune } from "../lib/config";

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Site officiel de la commune" } = Astro.props;
---
<!doctype html>
<html lang="fr" data-style={commune.style}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,500;1,600&display=swap"
      rel="stylesheet"
    />
    <script>
      (function () {
        try {
          var choix = localStorage.getItem("style-site");
          if (choix === "style1" || choix === "style2" || choix === "style3") {
            document.documentElement.setAttribute("data-style", choix);
          }
        } catch (e) {}
      })();
    </script>
    <style>
      :root {
        --bleu:    #003189;
        --rouge:   #E1000F;
        --blanc:   #FFFFFF;
        --gris-f:  #F5F5F5;
        --gris-t:  #6B6B6B;
        --texte:   #161616;
        --focus:   #0a76f6;

        /* Tokens de style — variante "simple" (sobre, coins droits) */
        --rayon:            4px;
        --rayon-lg:         6px;
        --rayon-petit:      3px;
        --surface:          var(--gris-f);
        --surface-hover:    #e8edf5;
        --surface-accent:   #EEF2FF;
        --surface-bordure:  transparent;
        --ombre-carte:      none;
        --fond-page:        var(--blanc);
        --flou:             none;
      }
      /* Style 2 — élégant / éditorial : Playfair Display, mise en page aérée, accents fins, tricolore conservé */
      html[data-style="style2"] {
        --rayon:            2px;
        --rayon-lg:         2px;
        --rayon-petit:      2px;
        --surface:          var(--blanc);
        --surface-hover:    #F7F5F0;
        --surface-accent:   #F7F5F0;
        --surface-bordure:  transparent;
        --ombre-carte:      none;
        --fond-page:        var(--blanc);
        --flou:             none;
        --ff-disp:          'Playfair Display', Georgia, serif;
      }

      /* Style 3 — affiche tricolore, effet wahou : Bebas Neue, aplats francs, ombre portée dure */
      html[data-style="style3"] {
        --rayon:            0px;
        --rayon-lg:         0px;
        --rayon-petit:      0px;
        --surface:          var(--blanc);
        --surface-hover:    #F0F4FA;
        --surface-accent:   #F0F4FA;
        --surface-bordure:  var(--bleu);
        --ombre-carte:      6px 6px 0 var(--rouge);
        --fond-page:        var(--blanc);
        --flou:             none;
        --ff-disp:          'Bebas Neue', Impact, sans-serif;
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { font-size: 16px; }
      body {
        font-family: "Marianne", Arial, sans-serif;
        color: var(--texte);
        background: var(--fond-page);
        background-attachment: fixed;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      a:focus-visible {
        outline: 3px solid var(--focus);
        outline-offset: 2px;
      }
      main { flex: 1; }
      .skip-link {
        position: absolute;
        top: -100%;
        left: 1rem;
        background: var(--bleu);
        color: var(--blanc);
        padding: 0.5rem 1rem;
        border-radius: 0 0 var(--rayon) var(--rayon);
        font-weight: 700;
        z-index: 9999;
        text-decoration: none;
      }
      .skip-link:focus { top: 0; }
    </style>
    <style is:global>
      @keyframes apparition {
        from { opacity: 0; transform: translateY(14px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes glisse-entree {
        from { opacity: 0; transform: translateX(-40px) scale(0.97); }
        to { opacity: 1; transform: none; }
      }

      /* Style 2 — titres en Playfair Display, filet rouge fin, mise en page éditoriale */
      html[data-style="style2"] h1,
      html[data-style="style2"] h2,
      html[data-style="style2"] h3 {
        font-family: var(--ff-disp);
        font-weight: 700;
      }
      html[data-style="style2"] main h2 {
        border-bottom: none;
        border-left: 2px solid var(--rouge);
        padding-left: 1rem;
        padding-bottom: 0;
        letter-spacing: 0.01em;
      }
      html[data-style="style2"] .conteneur > h1 {
        border-left: none;
        padding-left: 0;
        position: relative;
        padding-bottom: 0.85rem;
      }
      html[data-style="style2"] .conteneur > h1::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        width: 64px;
        height: 3px;
        background: var(--rouge);
      }

      /* Style 3 — titres en Bebas Neue, capitales, aplats francs */
      html[data-style="style3"] h1,
      html[data-style="style3"] h2,
      html[data-style="style3"] h3 {
        font-family: var(--ff-disp);
        text-transform: uppercase;
        letter-spacing: 0.02em;
        font-weight: 400;
      }
      html[data-style="style3"] main h2 {
        display: inline-block;
        border-bottom: none;
        background: var(--bleu);
        color: var(--blanc);
        padding: 0.3rem 1rem;
        font-size: 1.4rem;
      }
      html[data-style="style3"] .conteneur > h1 {
        border-left: none;
        padding-left: 0;
        padding-bottom: 0.6rem;
        border-bottom: 8px solid var(--rouge);
        display: inline-block;
        font-size: clamp(2rem, 5vw, 3.25rem);
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </head>
  <body>
    <a href="#contenu-principal" class="skip-link">Aller au contenu principal</a>
    <slot name="bandeau-urgence" />
    <slot name="nav" />
    <main id="contenu-principal" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>