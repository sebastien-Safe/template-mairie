---
import { commune } from "../lib/config";

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Site officiel de la commune" } = Astro.props;
---
<!doctype html>
<html lang="fr" data-style={commune.style}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      :root {
        --bleu:    #003189;
        --rouge:   #E1000F;
        --blanc:   #FFFFFF;
        --gris-f:  #F5F5F5;
        --gris-t:  #6B6B6B;
        --texte:   #161616;
        --focus:   #0a76f6;

        /* Tokens de style — variante "simple" (sobre, coins droits) */
        --rayon:            4px;
        --rayon-lg:         6px;
        --rayon-petit:      3px;
        --surface:          var(--gris-f);
        --surface-hover:    #e8edf5;
        --surface-accent:   #EEF2FF;
        --surface-bordure:  transparent;
        --ombre-carte:      none;
        --fond-page:        var(--blanc);
        --flou:             none;
      }
      html[data-style="moderne"] {
        --rayon:            18px;
        --rayon-lg:         22px;
        --rayon-petit:      8px;
        --surface:          rgb(255 255 255 / 55%);
        --surface-hover:    rgb(255 255 255 / 78%);
        --surface-accent:   rgb(0 49 137 / 10%);
        --surface-bordure:  rgb(255 255 255 / 55%);
        --ombre-carte:      0 8px 30px rgb(0 49 137 / 12%);
        --fond-page:        linear-gradient(160deg, #eef2ff 0%, #f6f7fb 45%, #eaf3ff 100%);
        --flou:             blur(16px);
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { font-size: 16px; }
      body {
        font-family: "Marianne", Arial, sans-serif;
        color: var(--texte);
        background: var(--fond-page);
        background-attachment: fixed;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      a:focus-visible {
        outline: 3px solid var(--focus);
        outline-offset: 2px;
      }
      main { flex: 1; }
      .skip-link {
        position: absolute;
        top: -100%;
        left: 1rem;
        background: var(--bleu);
        color: var(--blanc);
        padding: 0.5rem 1rem;
        border-radius: 0 0 var(--rayon) var(--rayon);
        font-weight: 700;
        z-index: 9999;
        text-decoration: none;
      }
      .skip-link:focus { top: 0; }
    </style>
  </head>
  <body>
    <a href="#contenu-principal" class="skip-link">Aller au contenu principal</a>
    <slot name="bandeau-urgence" />
    <slot name="nav" />
    <main id="contenu-principal" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>