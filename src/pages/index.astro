---
import CharteRepublicaine from "../layouts/CharteRepublicaine.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BandeauUrgence from "../components/BandeauUrgence.astro";
import Horaires from "../components/Horaires.astro";
import Actus from "../components/Actus.astro";
import { commune } from "../lib/config";
---

<CharteRepublicaine title={`Accueil — ${commune.nom_commune}`}>
  <BandeauUrgence slot="bandeau-urgence" />
  <Nav slot="nav" />

  <section class="hero">
    <div class="hero-inner">
      <h1>Bienvenue à {commune.nom_commune}</h1>
      <p class="accroche">Site officiel de la mairie</p>
    </div>
  </section>

  <div class="conteneur">
    <section class="bloc-horaires" aria-labelledby="titre-horaires">
      <h2 id="titre-horaires">Horaires d'ouverture</h2>
      <Horaires />
    </section>

    <section class="bloc-actus" aria-labelledby="titre-actus">
      <h2 id="titre-actus">Actualités</h2>
      <Actus />
    </section>

    <section class="bloc-contact" aria-labelledby="titre-contact">
      <h2 id="titre-contact">Nous contacter</h2>
      <address>
        <p>Mairie de {commune.nom_commune}</p>
        <p>{commune.adresse}</p>
        <p><a href={`tel:${commune.telephone.replace(/\s/g, "")}`}>{commune.telephone}</a></p>
        <p><a href={`mailto:${commune.email}`}>{commune.email}</a></p>
      </address>
    </section>
  </div>

  <Footer slot="footer" />
</CharteRepublicaine>

<style>
  .hero {
    background: var(--bleu);
    color: var(--blanc);
    padding: 3rem 1.5rem;
  }
  .hero-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .accroche {
    font-size: 1.125rem;
    opacity: 0.85;
  }
  .conteneur {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 768px) {
    .conteneur {
      grid-template-columns: 1fr 2fr;
    }
    .bloc-actus {
      grid-column: 2;
      grid-row: 1 / 3;
    }
  }
  h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--bleu);
    border-bottom: 2px solid var(--bleu);
    padding-bottom: 0.5rem;
    margin-bottom: 1.25rem;
  }
  address {
    font-style: normal;
    line-height: 1.8;
  }
  address a {
    color: var(--bleu);
    font-weight: 500;
  }
</style>