---
import CharteRepublicaine from "../layouts/CharteRepublicaine.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BandeauUrgence from "../components/BandeauUrgence.astro";
import Horaires from "../components/Horaires.astro";
import Actus from "../components/Actus.astro";
import SelecteurStyle from "../components/SelecteurStyle.astro";
import { commune } from "../lib/config";
---

<CharteRepublicaine title={`Accueil — ${commune.nom_commune}`}>
  <BandeauUrgence slot="bandeau-urgence" />
  <Nav slot="nav" />

  <section class="hero">
    <SelecteurStyle />
    <div class="hero-inner">
      <h1>Bienvenue à {commune.nom_commune}</h1>
      <p class="accroche">Site officiel de la mairie</p>
    </div>
  </section>

  <div class="conteneur">
    <section class="bloc-horaires" aria-labelledby="titre-horaires">
      <h2 id="titre-horaires">Horaires d'ouverture</h2>
      <Horaires />
    </section>

    <section class="bloc-actus" aria-labelledby="titre-actus">
      <h2 id="titre-actus">Actualités</h2>
      <Actus />
    </section>

    <section class="bloc-contact" aria-labelledby="titre-contact">
      <h2 id="titre-contact">Nous contacter</h2>
      <address>
        <p>Mairie de {commune.nom_commune}</p>
        <p>{commune.adresse}</p>
        <p><a href={`tel:${commune.telephone.replace(/\s/g, "")}`}>{commune.telephone}</a></p>
        <p><a href={`mailto:${commune.email}`}>{commune.email}</a></p>
      </address>
    </section>
  </div>

  <Footer slot="footer" />
</CharteRepublicaine>

<style>
  .hero {
    position: relative;
    background: var(--bleu);
    color: var(--blanc);
    padding: 3rem 1.5rem;
  }
  .hero-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .accroche {
    font-size: 1.125rem;
    opacity: 0.85;
  }
  .conteneur {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 768px) {
    .conteneur {
      grid-template-columns: 1fr 2fr;
    }
    .bloc-actus {
      grid-column: 2;
      grid-row: 1 / 3;
    }
  }
  h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--bleu);
    border-bottom: 2px solid var(--bleu);
    padding-bottom: 0.5rem;
    margin-bottom: 1.25rem;
  }
  address {
    font-style: normal;
    line-height: 1.8;
  }
  address a {
    color: var(--bleu);
    font-weight: 500;
  }

  /* Style 2 — hero éditorial : fond blanc, colonne étroite alignée à gauche, filet rouge court sous le titre */
  :global(html[data-style="style2"]) .hero {
    background: var(--blanc);
    color: var(--texte);
    padding: 4.5rem 1.5rem 3.5rem;
  }
  :global(html[data-style="style2"]) .hero-inner {
    max-width: 640px;
  }
  :global(html[data-style="style2"]) h1 {
    line-height: 1.1;
    animation: apparition 0.6s ease both;
  }
  :global(html[data-style="style2"]) h1::after {
    content: "";
    display: block;
    width: 64px;
    height: 3px;
    background: var(--rouge);
    margin-top: 1.25rem;
  }
  :global(html[data-style="style2"]) .accroche {
    font-family: var(--ff-disp);
    font-style: italic;
    font-weight: 500;
    font-size: 1.3rem;
    color: var(--gris-t);
    opacity: 1;
    margin-top: 1rem;
    animation: apparition 0.6s ease both 0.1s;
  }

  /* Style 3 — hero affiche : coin diagonal rouge sur fond bleu, titre géant qui glisse à l'ouverture */
  :global(html[data-style="style3"]) .hero {
    overflow: hidden;
  }
  :global(html[data-style="style3"]) .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    right: -5%;
    clip-path: polygon(55% 0, 100% 0, 100% 100%, 30% 100%);
    background: var(--rouge);
  }
  :global(html[data-style="style3"]) .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 640px;
  }
  :global(html[data-style="style3"]) h1 {
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 0.95;
    animation: glisse-entree 0.6s cubic-bezier(.2, .8, .2, 1) both;
  }
  :global(html[data-style="style3"]) .accroche {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 1rem;
    opacity: 1;
    animation: glisse-entree 0.6s cubic-bezier(.2, .8, .2, 1) both 0.12s;
  }
  @media (max-width: 700px) {
    :global(html[data-style="style3"]) .hero::after {
      display: none;
    }
  }
</style>