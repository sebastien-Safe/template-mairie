---
import CharteRepublicaine from "../layouts/CharteRepublicaine.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BandeauUrgence from "../components/BandeauUrgence.astro";
import { commune } from "../lib/config";

const demarches = [
  { titre: "Carte nationale d'identite", description: "Demande, renouvellement, perte ou vol.", url: "https://www.service-public.fr/particuliers/vosdroits/N358", source: "Service-Public.fr" },
  { titre: "Passeport", description: "Demande et renouvellement de passeport biometrique.", url: "https://www.service-public.fr/particuliers/vosdroits/N360", source: "Service-Public.fr" },
  { titre: "Permis de conduire", description: "Inscription au permis, duplicata, points.", url: "https://www.ants.gouv.fr/", source: "ANTS" },
  { titre: "Carte grise", description: "Certificat d'immatriculation pour un vehicule.", url: "https://www.ants.gouv.fr/", source: "ANTS" },
  { titre: "Actes d'etat civil", description: "Naissance, mariage, deces en ligne.", url: "https://www.service-public.fr/particuliers/vosdroits/N359", source: "Service-Public.fr" },
  { titre: "Listes electorales", description: "Verifier ou s'inscrire en ligne.", url: "https://www.service-public.fr/particuliers/vosdroits/R45333", source: "Service-Public.fr" },
  { titre: "Recensement citoyen", description: "Obligation de recensement a 16 ans.", url: "https://www.service-public.fr/particuliers/vosdroits/F870", source: "Service-Public.fr" },
  { titre: "Aide sociale et allocations", description: "CAF, aides au logement, RSA, AAH.", url: "https://www.caf.fr/", source: "CAF" },
];
---

<CharteRepublicaine title={`Démarches administratives — ${commune.nom_commune}`}>
  <BandeauUrgence slot="bandeau-urgence" />
  <Nav slot="nav" />

  <div class="conteneur">
    <h1>Démarches administratives</h1>

    <div class="notice" role="note">
      <p>Pour protéger vos données personnelles, la mairie de {commune.nom_commune} vous redirige vers les sites officiels de l'État pour toutes vos démarches en ligne.</p>
    </div>

    <ul class="liste-demarches" role="list">
      {demarches.map((d) => (
        <li>
          <a href={d.url} target="_blank" rel="noopener noreferrer" class="demarche-carte">
            <div class="demarche-contenu">
              <strong>{d.titre}</strong>
              <p>{d.description}</p>
            </div>
            <span class="badge">{d.source}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <Footer slot="footer" />
</CharteRepublicaine>

<style>
  .conteneur {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  h1 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--bleu);
    border-left: 5px solid var(--rouge);
    padding-left: 1rem;
  }
  .notice {
    background: var(--surface-accent);
    border-left: 4px solid var(--bleu);
    padding: 1rem 1.25rem;
    border-radius: 0 var(--rayon) var(--rayon) 0;
    box-shadow: var(--ombre-carte);
    backdrop-filter: var(--flou);
    -webkit-backdrop-filter: var(--flou);
    font-size: 0.9rem;
    color: var(--texte);
  }
  .liste-demarches {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
  .demarche-carte {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--surface-bordure);
    border-radius: var(--rayon);
    box-shadow: var(--ombre-carte);
    backdrop-filter: var(--flou);
    -webkit-backdrop-filter: var(--flou);
    border-left: 4px solid var(--bleu);
    text-decoration: none;
    color: var(--texte);
    height: 100%;
    transition: background 0.15s;
  }
  .demarche-carte:hover { background: var(--surface-hover); }
  .demarche-contenu strong {
    display: block;
    color: var(--bleu);
    font-weight: 600;
    margin-bottom: 0.35rem;
  }
  .demarche-contenu p {
    font-size: 0.875rem;
    color: var(--gris-t);
    line-height: 1.5;
  }
  .badge {
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--bleu);
    color: var(--blanc);
    padding: 0.2rem 0.5rem;
    border-radius: var(--rayon-petit);
    white-space: nowrap;
  }

  :global(html[data-style="foret"]) .notice,
  :global(html[data-style="techno"]) .notice,
  :global(html[data-style="foret"]) .demarche-carte,
  :global(html[data-style="techno"]) .demarche-carte {
    border-left: none;
    position: relative;
  }
  :global(html[data-style="foret"]) .notice::before,
  :global(html[data-style="techno"]) .notice::before,
  :global(html[data-style="foret"]) .demarche-carte::before,
  :global(html[data-style="techno"]) .demarche-carte::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    border-radius: var(--rayon) 0 0 var(--rayon);
    background: var(--degrade-vif);
  }
  :global(html[data-style="foret"]) .badge,
  :global(html[data-style="techno"]) .badge {
    background: var(--degrade-vif);
  }
  :global(html[data-style="foret"]) .demarche-carte {
    transition: transform 0.2s linear, box-shadow 0.2s linear;
  }
  :global(html[data-style="foret"]) .demarche-carte:hover {
    transform: translateY(-4px);
    box-shadow: var(--ombre-carte);
  }
  :global(html[data-style="techno"]) .demarche-carte {
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  :global(html[data-style="techno"]) .demarche-carte:hover {
    transform: translateY(-4px);
    box-shadow: var(--ombre-glow);
  }
</style>