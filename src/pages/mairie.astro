---
import CharteRepublicaine from "../layouts/CharteRepublicaine.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BandeauUrgence from "../components/BandeauUrgence.astro";
import ConseilMunicipal from "../components/ConseilMunicipal.astro";
import { commune, identite } from "../lib/config";
---

<CharteRepublicaine title={`La mairie — ${commune.nom_commune}`}>
  <BandeauUrgence slot="bandeau-urgence" />
  <Nav slot="nav" />

  <div class="conteneur">
    <h1>La mairie</h1>

    {identite.photo_mairie && (
      <img
        src={identite.photo_mairie}
        alt={`Mairie de ${commune.nom_commune}`}
        class="photo-mairie"
      />
    )}

    <section aria-labelledby="titre-conseil">
      <h2 id="titre-conseil">Le conseil municipal</h2>
      <ConseilMunicipal />
    </section>

    <section aria-labelledby="titre-pv">
      <h2 id="titre-pv">Comptes-rendus et procès-verbaux</h2>
      <p class="intro">
        Les comptes-rendus des séances du conseil municipal sont disponibles
        en téléchargement ci-dessous.
      </p>
      <ul class="documents" role="list">
        <li>
          <a href="/docs/cr-2026-06.pdf" class="doc-lien">
            <span class="doc-icone" aria-hidden="true">📄</span>
            <span>
              <strong>Compte-rendu — Juin 2026</strong>
              <small>PDF — Conseil municipal du 15 juin 2026</small>
            </span>
          </a>
        </li>
      </ul>
    </section>
  </div>

  <Footer slot="footer" />
</CharteRepublicaine>

<style>
  .conteneur {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  h1 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--bleu);
    border-left: 5px solid var(--rouge);
    padding-left: 1rem;
  }
  h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--bleu);
    border-bottom: 2px solid var(--bleu);
    padding-bottom: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .photo-mairie {
    width: 100%;
    max-height: 320px;
    object-fit: cover;
    border-radius: var(--rayon-lg);
  }
  .intro {
    color: var(--gris-t);
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }
  .documents { list-style: none; display: flex; flex-direction: column; gap: 0.75rem; }
  .doc-lien {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 1rem;
    background: var(--surface);
    border: 1px solid var(--surface-bordure);
    border-radius: var(--rayon);
    box-shadow: var(--ombre-carte);
    backdrop-filter: var(--flou);
    -webkit-backdrop-filter: var(--flou);
    text-decoration: none;
    color: var(--texte);
    border-left: 4px solid var(--bleu);
    transition: background 0.15s;
  }
  .doc-lien:hover { background: var(--surface-hover); }
  .doc-lien strong { display: block; color: var(--bleu); font-weight: 600; }
  .doc-lien small { color: var(--gris-t); font-size: 0.8rem; }
  .doc-icone { font-size: 1.5rem; flex-shrink: 0; }

  :global(html[data-style="moderne"]) .photo-mairie {
    transition: transform 0.35s ease;
  }
  :global(html[data-style="moderne"]) .photo-mairie:hover {
    transform: scale(1.015);
  }
  :global(html[data-style="moderne"]) .doc-lien {
    border-left: none;
    position: relative;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  :global(html[data-style="moderne"]) .doc-lien::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    border-radius: var(--rayon) 0 0 var(--rayon);
    background: var(--degrade-vif);
  }
  :global(html[data-style="moderne"]) .doc-lien:hover {
    transform: translateY(-3px);
    box-shadow: var(--ombre-glow);
  }
</style>