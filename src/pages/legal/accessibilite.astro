---
import CharteRepublicaine from "../../layouts/CharteRepublicaine.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { commune } from "../../lib/config";

const dateAudit = "2026-07-21";
---

<CharteRepublicaine title={`Accessibilité — ${commune.nom_commune}`}>
  <Nav slot="nav" />

  <div class="conteneur">
    <h1>Déclaration d'accessibilité</h1>

    <p class="intro">
      La commune de {commune.nom_commune} s'engage à rendre son site internet accessible
      conformément à l'article 47 de la loi n°2005-102 du 11 février 2005.
    </p>

    <section aria-labelledby="titre-conformite">
      <h2 id="titre-conformite">État de conformité</h2>
      <p>
        Le site <strong>{commune.nom_domaine}</strong> est en <strong>conformité partielle</strong>
        avec le référentiel général d'amélioration de l'accessibilité (RGAA 4.1)
        en raison des non-conformités listées ci-dessous.
      </p>
    </section>

    <section aria-labelledby="titre-nc">
      <h2 id="titre-nc">Contenus non accessibles</h2>
      <ul class="liste">
        <li>
          Les documents PDF téléchargeables (comptes-rendus du conseil municipal)
          peuvent ne pas être entièrement accessibles aux lecteurs d'écran.
        </li>
      </ul>
    </section>

    <section aria-labelledby="titre-contact">
      <h2 id="titre-contact">Signaler un problème</h2>
      <p>
        Si vous rencontrez un défaut d'accessibilité vous empêchant d'accéder
        à un contenu ou à une fonctionnalité, contactez-nous :
      </p>
      <ul class="liste">
        <li>Par email : <a href={`mailto:${commune.email}`}>{commune.email}</a></li>
        <li>Par téléphone : <a href={`tel:${commune.telephone.replace(/\s/g, "")}`}>{commune.telephone}</a></li>
      </ul>
    </section>

    <section aria-labelledby="titre-recours">
      <h2 id="titre-recours">Voie de recours</h2>
      <p>
        Si vous n'obtenez pas de réponse rapide, vous pouvez contacter
        le Défenseur des droits via
        <a href="https://www.defenseurdesdroits.fr" target="_blank" rel="noopener">
          defenseurdesdroits.fr
        </a>.
      </p>
    </section>

    <p class="date-audit">
      Cette déclaration a été établie le
      <time datetime={dateAudit}>21 juillet 2026</time>.
    </p>
  </div>

  <Footer slot="footer" />
</CharteRepublicaine>

<style>
  .conteneur {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  h1 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--bleu);
    border-left: 5px solid var(--rouge);
    padding-left: 1rem;
  }
  h2 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--bleu);
    border-bottom: 2px solid var(--bleu);
    padding-bottom: 0.4rem;
    margin-bottom: 1rem;
  }
  p, li { font-size: 0.9rem; line-height: 1.7; color: var(--gris-t); }
  p a, li a { color: var(--bleu); }
  .intro { font-size: 1rem; color: var(--texte); }
  .liste { padding-left: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .date-audit {
    font-size: 0.8rem;
    color: var(--gris-t);
    font-style: italic;
    border-top: 1px solid var(--gris-f);
    padding-top: 1rem;
  }
</style>